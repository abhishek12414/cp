{
  "name": "currentshop",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "APP_ENV=development expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:prod": "APP_ENV=production expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_ENV=development expo start --android",
    "android:staging": "APP_ENV=staging expo start --android",
    "android:prod": "APP_ENV=production expo start --android",
    "ios": "APP_ENV=development expo start --ios",
    "ios:staging": "APP_ENV=staging expo start --ios",
    "ios:prod": "APP_ENV=production expo start --ios",
    "web": "APP_ENV=development expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "build:dev": "npx eas build --profile development --platform all",
    "build:dev:android": "npx eas build --profile development --platform android",
    "build:dev:ios": "npx eas build --profile development --platform ios",
    "build:preview": "npx eas build --profile preview --platform all",
    "build:preview:android": "npx eas build --profile preview --platform android",
    "build:preview:ios": "npx eas build --profile preview --platform ios",
    "build:prod": "npx eas build --profile production --platform all",
    "build:prod:android": "npx eas build --profile production --platform android",
    "build:prod:ios": "npx eas build --profile production --platform ios",
    "update:dev": "APP_ENV=development npx eas update --channel development --message",
    "update:staging": "APP_ENV=staging npx eas update --channel staging --message",
    "update:prod": "APP_ENV=production npx eas update --channel production --message"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.85.5",
    "async-storage": "^0.1.0",
    "axios": "^1.13.2",
    "expo": "~55.0.25",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.15",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.23",
    "expo-web-browser": "~55.0.16",
    "formik": "^2.4.9",
    "qs": "^6.14.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "^9.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "@types/yup": "^0.29.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.9.2"
  }
}
